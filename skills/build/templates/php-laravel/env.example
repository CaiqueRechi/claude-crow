# Local Docker environment (/rm:build). Values below are placeholders;
# .env gets generated local values and never goes to git.
COMPOSE_PROJECT_NAME=project-slug
APP_PORT=8080
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-local-only
DB_FORWARD_PORT=33060
