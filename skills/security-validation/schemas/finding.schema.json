{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Achado de validação de segurança",
  "description": "Formato de um achado (seção 12.2 da especificação). Evidência sensível é sempre redigida.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "rule_id",
    "asset",
    "status",
    "severity",
    "confidence",
    "title",
    "evidence",
    "impact",
    "root_cause",
    "references",
    "recommendation",
    "limitations",
    "false_positive_review"
  ],
  "properties": {
    "finding_id": { "type": "string", "pattern": "^FIND-[0-9]{4,}$" },
    "rule_id": { "type": "string", "pattern": "^SV-[A-Z]{2,4}-[0-9]{4}$" },
    "asset": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE", "NOT_TESTED", "ERROR", "SUPPRESSED"]
    },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "title": { "type": "string", "minLength": 3 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "location", "redacted"],
      "properties": {
        "type": {
          "enum": [
            "source_analysis",
            "configuration",
            "dependency_analysis",
            "dynamic_test",
            "log_review",
            "manual_review"
          ]
        },
        "location": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "detail": { "type": "string" },
        "reproduction": { "type": "string" },
        "redacted": { "type": "boolean" }
      }
    },
    "impact": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "root_cause": { "type": "string", "minLength": 3 },
    "references": { "type": "array", "items": { "type": "string" } },
    "cvss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "vector"],
      "properties": {
        "version": { "type": "string" },
        "vector": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "priority": { "enum": ["P1", "P2", "P3", "P4"] },
    "recommendation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "regression_test": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "false_positive_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["pending", "completed"] },
        "rationale": { "type": "string" }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_on", "expires_on", "justification", "residual_risk"],
      "properties": {
        "approved_by": { "type": "string" },
        "approved_on": { "type": "string", "format": "date" },
        "expires_on": { "type": "string", "format": "date" },
        "justification": { "type": "string" },
        "residual_risk": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_status", "current_status", "date"],
      "properties": {
        "previous_status": { "type": "string" },
        "current_status": { "type": "string" },
        "date": { "type": "string" },
        "evidence": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUPPRESSED" } } },
      "then": { "required": ["suppression"] }
    }
  ]
}
